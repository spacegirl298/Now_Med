// Security rules tests for the family dashboard (guardian access to children).
//
//   npm run test:rules
//
// Kept in its own file with its own project id so it can run in parallel with
// firestore.rules.test.js without the two clearing each other's data.
// The writes below copy what the app really sends (createAppointment,
// cancelAppointment, sendMessage, createDoctorRating, addChild).
import { readFileSync } from 'node:fs'
import {
  initializeTestEnvironment,
  assertFails,
  assertSucceeds,
} from '@firebase/rules-unit-testing'
import {
  doc,
  getDoc,
  getDocs,
  setDoc,
  addDoc,
  updateDoc,
  deleteDoc,
  writeBatch,
  collection,
  query,
  where,
  increment,
  serverTimestamp,
  Timestamp,
} from 'firebase/firestore'
import { afterAll, beforeAll, beforeEach, describe, it } from 'vitest'

const HOUR = 60 * 60 * 1000
const DAY = 24 * HOUR
const YEAR = 365 * DAY
let testEnv

const at = (ms) => Timestamp.fromMillis(Date.now() + ms)

// ---- who is calling -------------------------------------------------------
const parent = (uid) =>
  testEnv
    .authenticatedContext(uid, { email: `${uid}@test.com`, email_verified: true })
    .firestore()
const secretary = () =>
  testEnv
    .authenticatedContext('sec1', { email: 'sec@practice.com', email_verified: true })
    .firestore()

// ---- data -----------------------------------------------------------------
// parentA is guardian of every kid below; parentB is a stranger.
const childDoc = (extra = {}) => ({
  firstName: 'Kid',
  lastName: 'Test',
  name: 'Kid Test',
  dateOfBirth: '2018-01-01',
  idType: 'none',
  idNumber: '',
  guardianIds: ['parentA'],
  primaryGuardianId: 'parentA',
  guardians: { parentA: { name: 'Parent A', relationship: 'mother' } },
  status: 'managed',
  verificationStatus: 'pending',
  turns12At: at(4 * YEAR), // under 12
  turns18At: at(10 * YEAR),
  createdBy: 'parentA',
  createdAt: Timestamp.now(),
  ...extra,
})

const appt = (patientId, hoursAhead) => ({
  patientId,
  doctorId: 'doc1',
  status: 'confirmed',
  date: '2030-01-01',
  time: '10:00',
  appointmentAt: at(hoursAhead * HOUR),
})

async function seed() {
  await testEnv.withSecurityRulesDisabled(async (ctx) => {
    const db = ctx.firestore()
    await setDoc(doc(db, 'staffInvites/sec@practice.com'), { by: 'console' })
    await setDoc(doc(db, 'secretaryDirectory/sec1'), { uid: 'sec1' })

    // young + pending (the state right after a parent adds a child)
    await setDoc(doc(db, 'children/kidPending'), childDoc())
    // young + verified by the practice
    await setDoc(doc(db, 'children/kidVerified'), childDoc({ verificationStatus: 'verified' }))
    // 12-17: verified, but past the 12th birthday
    await setDoc(
      doc(db, 'children/kidTeen'),
      childDoc({ verificationStatus: 'verified', turns12At: at(-2 * YEAR), turns18At: at(4 * YEAR) }),
    )
    // already 18
    await setDoc(
      doc(db, 'children/kidAdult'),
      childDoc({ verificationStatus: 'verified', turns12At: at(-6 * YEAR), turns18At: at(-DAY) }),
    )

    await setDoc(doc(db, 'appointments/apptKid4h'), appt('kidPending', 4))
    await setDoc(doc(db, 'appointments/apptKid2h'), appt('kidPending', 2))
    await setDoc(doc(db, 'appointments/apptAdult'), appt('kidAdult', 4))

    await setDoc(doc(db, 'records/recPending'), { patientId: 'kidPending', notes: 'private' })
    await setDoc(doc(db, 'records/recVerified'), { patientId: 'kidVerified', notes: 'private' })
    await setDoc(doc(db, 'records/recTeen'), { patientId: 'kidTeen', notes: 'private' })
    await setDoc(doc(db, 'records/recAdult'), { patientId: 'kidAdult', notes: 'private' })
    await setDoc(doc(db, 'patientProfiles/profVerified'), { patientId: 'kidVerified', allergies: 'x' })
    await setDoc(doc(db, 'intakeForms/intakeVerified'), { patientId: 'kidVerified', submittedBy: 'secretary' })

    await setDoc(doc(db, 'conversations/kidPending'), {
      patientId: 'kidPending',
      lastSenderRole: 'secretary',
      unreadForStaff: 0,
      unreadForPatient: 1,
    })
    await setDoc(doc(db, 'conversations/kidPending/messages/m1'), {
      senderId: 'sec1',
      senderRole: 'secretary',
      kind: 'message',
      text: 'hello',
    })

    await setDoc(doc(db, 'notifications/nKid'), {
      recipientId: 'kidPending',
      patientId: 'kidPending',
      type: 'message',
      message: 'New message from the practice',
      read: false,
    })
    await setDoc(doc(db, 'notifications/nAdult'), {
      recipientId: 'kidAdult',
      type: 'confirmation',
      message: 'old',
      read: false,
    })
  })
}

beforeAll(async () => {
  testEnv = await initializeTestEnvironment({
    projectId: 'demo-now-med-family',
    firestore: { rules: readFileSync('firestore.rules', 'utf8') },
  })
})
afterAll(async () => {
  await testEnv.cleanup()
})
beforeEach(async () => {
  await testEnv.clearFirestore()
  await seed()
})

const byField = (db, col, field, value) =>
  getDocs(query(collection(db, col), where(field, '==', value)))

// ---------------------------------------------------------------------------
describe('child profiles', () => {
  it('a guardian can read their child', async () => {
    await assertSucceeds(getDoc(doc(parent('parentA'), 'children/kidPending')))
  })
  it('a guardian can list their children (the Family page query)', async () => {
    const q = query(collection(parent('parentA'), 'children'), where('guardianIds', 'array-contains', 'parentA'))
    await assertSucceeds(getDocs(q))
  })
  it("a stranger cannot read someone else's child", async () => {
    await assertFails(getDoc(doc(parent('parentB'), 'children/kidPending')))
  })
  it('a guardian cannot read the profile once the child is 18', async () => {
    await assertFails(getDoc(doc(parent('parentA'), 'children/kidAdult')))
  })
  it('a secretary can read and verify a child', async () => {
    await assertSucceeds(getDoc(doc(secretary(), 'children/kidPending')))
    await assertSucceeds(updateDoc(doc(secretary(), 'children/kidPending'), { verificationStatus: 'verified' }))
  })
  it('a parent cannot verify their own child', async () => {
    await assertFails(updateDoc(doc(parent('parentA'), 'children/kidPending'), { verificationStatus: 'verified' }))
  })
  it('a parent cannot add another guardian by editing the profile', async () => {
    await assertFails(updateDoc(doc(parent('parentA'), 'children/kidPending'), { guardianIds: ['parentA', 'parentB'] }))
  })
  it('a parent cannot delete a child profile', async () => {
    await assertFails(deleteDoc(doc(parent('parentA'), 'children/kidPending')))
  })
})

describe('adding a child (what addChild sends)', () => {
  const create = (db, id, extra) =>
    setDoc(doc(db, `children/${id}`), {
      ...childDoc({ createdAt: serverTimestamp() }),
      guardianIds: ['parentB'],
      primaryGuardianId: 'parentB',
      createdBy: 'parentB',
      guardians: { parentB: { name: 'Parent B', relationship: 'father' } },
      ...extra,
    })

  it('a parent can add a child as pending', async () => {
    await assertSucceeds(create(parent('parentB'), 'newKid'))
  })
  it('cannot be created already verified', async () => {
    await assertFails(create(parent('parentB'), 'newKid', { verificationStatus: 'verified' }))
  })
  it('cannot list someone else as the guardian', async () => {
    await assertFails(create(parent('parentB'), 'newKid', { guardianIds: ['parentA'] }))
  })
  it('cannot be created in another parent\'s name', async () => {
    await assertFails(create(parent('parentB'), 'newKid', { createdBy: 'parentA' }))
  })
  it('cannot carry extra fields', async () => {
    await assertFails(create(parent('parentB'), 'newKid', { relationship: 'mother' }))
  })
  it('cannot be created for someone who is already 18', async () => {
    await assertFails(create(parent('parentB'), 'newKid', { turns18At: at(-DAY) }))
  })
  it('cannot push the 18th-birthday cut-off past 18 years', async () => {
    await assertFails(create(parent('parentB'), 'newKid', { turns18At: at(30 * YEAR) }))
  })
  // Expected to FAIL until rules patch 3 is applied (see the notes in chat):
  // without it, a parent can stretch the "under 12" window as far as they like.
  it('cannot push the 12th-birthday cut-off into the future', async () => {
    await assertFails(create(parent('parentB'), 'newKid', { turns12At: at(15 * YEAR) }))
  })
})

describe('booking for a child (what createAppointment sends)', () => {
  const book = (db, childId) => {
    const batch = writeBatch(db)
    batch.set(doc(db, 'appointments/newAppt'), appt(childId, 24))
    batch.set(doc(db, 'appointmentSlots/slot1'), {
      date: '2030-01-02',
      time: '09:00',
      status: 'booked',
      appointmentId: 'newAppt',
      patientId: childId,
      doctorId: 'doc1',
    })
    return batch.commit()
  }

  it('a guardian can book an appointment and its slot for their child', async () => {
    await assertSucceeds(book(parent('parentA'), 'kidPending'))
  })
  it("a stranger cannot book for someone else's child", async () => {
    await assertFails(book(parent('parentB'), 'kidPending'))
  })
  it('a guardian cannot book once the child is 18', async () => {
    await assertFails(book(parent('parentA'), 'kidAdult'))
  })
  // Expected to FAIL until rules patch 1 is applied. createAppointment awaits
  // this write right after the booking commits, so without the patch the parent
  // sees an error even though the appointment was created.
  it('a guardian can send the booking confirmation notification for the child', async () => {
    await assertSucceeds(
      addDoc(collection(parent('parentA'), 'notifications'), {
        recipientId: 'kidPending',
        appointmentId: 'newAppt',
        patientId: null,
        changeRequestId: null,
        type: 'confirmation',
        message: 'Your appointment is booked.',
        read: false,
        createdAt: serverTimestamp(),
      }),
    )
  })
  it("a stranger cannot send notifications to someone else's child", async () => {
    await assertFails(
      addDoc(collection(parent('parentB'), 'notifications'), {
        recipientId: 'kidPending',
        type: 'confirmation',
        message: 'spam',
        read: false,
        createdAt: serverTimestamp(),
      }),
    )
  })
})

describe("reading a child's appointments", () => {
  it('a guardian can read one appointment', async () => {
    await assertSucceeds(getDoc(doc(parent('parentA'), 'appointments/apptKid4h')))
  })
  it('a guardian can list their child\'s appointments (the Family page query)', async () => {
    await assertSucceeds(byField(parent('parentA'), 'appointments', 'patientId', 'kidPending'))
  })
  it("a stranger cannot read or list a child's appointments", async () => {
    await assertFails(getDoc(doc(parent('parentB'), 'appointments/apptKid4h')))
    await assertFails(byField(parent('parentB'), 'appointments', 'patientId', 'kidPending'))
  })
  it('a guardian loses access to appointments at 18', async () => {
    await assertFails(getDoc(doc(parent('parentA'), 'appointments/apptAdult')))
    await assertFails(byField(parent('parentA'), 'appointments', 'patientId', 'kidAdult'))
  })
})

describe("cancelling and reporting late for a child's appointment", () => {
  const cancel = (db, id) =>
    updateDoc(doc(db, `appointments/${id}`), {
      status: 'cancelled',
      cancelledAt: serverTimestamp(),
      cancelledBy: 'parentA',
      updatedAt: serverTimestamp(),
    })

  it('a guardian can cancel 4 hours before', async () => {
    await assertSucceeds(cancel(parent('parentA'), 'apptKid4h'))
  })
  it('a guardian cannot cancel 2 hours before', async () => {
    await assertFails(cancel(parent('parentA'), 'apptKid2h'))
  })
  it("a stranger cannot cancel a child's appointment", async () => {
    await assertFails(cancel(parent('parentB'), 'apptKid4h'))
  })
  it('a guardian can say they are running late', async () => {
    await assertSucceeds(
      updateDoc(doc(parent('parentA'), 'appointments/apptKid4h'), {
        patientRunningLate: true,
        patientRunningLateMinutes: 10,
        patientRunningLateAt: serverTimestamp(),
        updatedAt: serverTimestamp(),
      }),
    )
  })
  it('a guardian cannot change the appointment in other ways', async () => {
    await assertFails(updateDoc(doc(parent('parentA'), 'appointments/apptKid4h'), { doctorId: 'someone-else' }))
  })
  // Same notification write as booking: needs rules patch 1.
  it('a guardian can send the cancellation notification for the child', async () => {
    await assertSucceeds(
      addDoc(collection(parent('parentA'), 'notifications'), {
        recipientId: 'kidPending',
        appointmentId: 'apptKid4h',
        type: 'cancellation',
        message: 'Your appointment has been cancelled.',
        read: false,
        createdAt: serverTimestamp(),
      }),
    )
  })
})

describe("a child's medical data", () => {
  it('is hidden from a guardian until the practice verifies them', async () => {
    await assertFails(getDoc(doc(parent('parentA'), 'records/recPending')))
    await assertFails(byField(parent('parentA'), 'records', 'patientId', 'kidPending'))
  })
  it('becomes readable once verified (record, profile, intake form)', async () => {
    const db = parent('parentA')
    await assertSucceeds(getDoc(doc(db, 'records/recVerified')))
    await assertSucceeds(byField(db, 'records', 'patientId', 'kidVerified'))
    await assertSucceeds(getDoc(doc(db, 'patientProfiles/profVerified')))
    await assertSucceeds(getDoc(doc(db, 'intakeForms/intakeVerified')))
  })
  it('is hidden from a verified guardian after the 12th birthday', async () => {
    await assertFails(getDoc(doc(parent('parentA'), 'records/recTeen')))
  })
  it('is hidden from a guardian after the 18th birthday', async () => {
    await assertFails(getDoc(doc(parent('parentA'), 'records/recAdult')))
  })
  it('is hidden from a stranger even when verified', async () => {
    await assertFails(getDoc(doc(parent('parentB'), 'records/recVerified')))
  })
  it('can never be written by a guardian', async () => {
    const db = parent('parentA')
    await assertFails(setDoc(doc(db, 'records/forged'), { patientId: 'kidVerified', notes: 'forged' }))
    await assertFails(updateDoc(doc(db, 'records/recVerified'), { notes: 'edited' }))
    await assertFails(updateDoc(doc(db, 'patientProfiles/profVerified'), { allergies: 'none' }))
  })
  it('stays readable by a secretary', async () => {
    await assertSucceeds(getDoc(doc(secretary(), 'records/recPending')))
  })
})

describe("messaging the practice about a child (what sendMessage sends)", () => {
  // Built per caller so senderId matches the signed-in user, as sendMessage does.
  const sendAs = (uid, childId) => {
    const db = parent(uid)
    const batch = writeBatch(db)
    batch.set(doc(collection(db, `conversations/${childId}/messages`)), {
      senderId: uid,
      senderRole: 'patient',
      senderName: 'Parent (guardian of Kid)',
      text: 'Is the doctor running late?',
      kind: 'message',
      explicitLanguage: false,
      crisisLanguage: false,
      appointmentId: null,
      createdAt: serverTimestamp(),
    })
    batch.set(
      doc(db, `conversations/${childId}`),
      {
        patientId: childId,
        patientName: 'Kid Test',
        lastMessage: 'Is the doctor running late?',
        lastMessageAt: serverTimestamp(),
        lastSenderRole: 'patient',
        unreadForStaff: increment(1),
      },
      { merge: true },
    )
    return batch.commit()
  }

  it('a guardian can read the conversation', async () => {
    const db = parent('parentA')
    await assertSucceeds(getDoc(doc(db, 'conversations/kidPending')))
    await assertSucceeds(getDoc(doc(db, 'conversations/kidPending/messages/m1')))
  })
  it('a guardian can send into an existing conversation', async () => {
    await assertSucceeds(sendAs('parentA', 'kidPending'))
  })
  it('a guardian can start a brand-new conversation for the child', async () => {
    await assertSucceeds(sendAs('parentA', 'kidVerified'))
  })
  it('a guardian can mark the conversation read', async () => {
    await assertSucceeds(updateDoc(doc(parent('parentA'), 'conversations/kidPending'), { unreadForPatient: 0 }))
  })
  it("a stranger cannot read or write a child's conversation", async () => {
    await assertFails(getDoc(doc(parent('parentB'), 'conversations/kidPending')))
    await assertFails(sendAs('parentB', 'kidPending'))
  })
  it('a guardian cannot send once the child is 18', async () => {
    await assertFails(sendAs('parentA', 'kidAdult'))
  })
  it('a guardian cannot post as the practice', async () => {
    const db = parent('parentA')
    await assertFails(
      setDoc(doc(collection(db, 'conversations/kidPending/messages')), {
        senderId: 'parentA',
        senderRole: 'secretary',
        kind: 'message',
        text: 'pretending',
      }),
    )
  })
})

describe("a child's notifications (delay alerts reach the parent)", () => {
  it('a guardian can list them (the bell query) and mark one read', async () => {
    const db = parent('parentA')
    await assertSucceeds(byField(db, 'notifications', 'recipientId', 'kidPending'))
    await assertSucceeds(updateDoc(doc(db, 'notifications/nKid'), { read: true }))
  })
  it("a stranger cannot read a child's notifications", async () => {
    await assertFails(byField(parent('parentB'), 'notifications', 'recipientId', 'kidPending'))
  })
  it('a guardian stops receiving them at 18', async () => {
    await assertFails(byField(parent('parentA'), 'notifications', 'recipientId', 'kidAdult'))
  })
})

describe('reviewing a visit for a child', () => {
  const review = (patientId, appointmentId) => ({
    patientId, // the reviewer: the parent
    appointmentId,
    doctorId: 'doc1',
    rating: 5,
    comment: 'Great',
    hidden: false,
  })
  // Expected to FAIL until rules patch 2 is applied: ReviewPrompt appears on the
  // child's calendar, and without the patch every review shows an error.
  it('a guardian can review their child\'s visit', async () => {
    await assertSucceeds(setDoc(doc(parent('parentA'), 'doctorRatings/apptKid4h'), review('parentA', 'apptKid4h')))
  })
  it("a stranger cannot review someone else's child's visit", async () => {
    await assertFails(setDoc(doc(parent('parentB'), 'doctorRatings/apptKid4h'), review('parentB', 'apptKid4h')))
  })
})