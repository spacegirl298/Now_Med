rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasStaffInvite() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/staffInvites/$(request.auth.token.email.lower()));
    }

    function isSecretary() {
      return hasStaffInvite() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSecretaryRecipient(uid) {
      return isSignedIn()
        && uid != null
        && exists(/databases/$(database)/documents/secretaryDirectory/$(uid));
    }

    function isUnclaimedByCallerIdNumber() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && resource.data.patientId == null
        && resource.data.patientIdNumber == callerDoc().data.idNumber;
    }

    function patientEditableProfileFields() {
      return [
        'patientId',
        'patientIdNumber',
        'occupation',
        'maritalStatus',
        'emergencyContactName',
        'emergencyContactPhone',
        'medicalAidProvider',
        'medicalAidNumber',
        'updatedAt'
      ];
    }

    // ---------- Family / guardian helpers ----------


function isGuardianOf(childId) {
  return request.auth != null
    && request.auth.token.email_verified == true
    && childId is string
    && exists(/databases/$(database)/documents/children/$(childId))
    && request.auth.uid in get(
      /databases/$(database)/documents/children/$(childId)
    ).data.guardianIds
    && request.time < get(
      /databases/$(database)/documents/children/$(childId)
    ).data.turns18At;
}

function isActiveGuardianOf(childId) {
  return isGuardianOf(childId)
    && get(
      /databases/$(database)/documents/children/$(childId)
    ).data.get('verificationStatus', 'pending') != 'rejected';
}

// Verified guardians can access clinical data only before
// the child's 12th birthday.
function isVerifiedGuardianOf(childId) {
  return isActiveGuardianOf(childId)
    && get(
      /databases/$(database)/documents/children/$(childId)
    ).data.verificationStatus == 'verified'
    && request.time < get(
      /databases/$(database)/documents/children/$(childId)
    ).data.turns12At;
}

    // Appointment slot ownership, including guardian access.
 function ownsAppointmentSlot(appointmentId) {
  return isSignedIn()
    && appointmentId != null
    && exists(/databases/$(database)/documents/appointments/$(appointmentId))
    && (
      get(
        /databases/$(database)/documents/appointments/$(appointmentId)
      ).data.patientId == request.auth.uid
      || isActiveGuardianOf(
        get(
          /databases/$(database)/documents/appointments/$(appointmentId)
        ).data.patientId
      )
    );
}

    function isGuardianAppointmentNotification() {
      return isSignedIn()
        && request.resource.data.recipientId is string
        && isActiveGuardianOf(request.resource.data.recipientId)
        && request.resource.data.appointmentId is string
        && exists(
          /databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)
        )
        && get(
          /databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)
        ).data.patientId == request.resource.data.recipientId
        && request.resource.data.type == 'confirmation';
    }

    // ---------- users ----------

    match /users/{userId} {
      allow get: if isOwner(userId) || isSecretary();
      allow list: if isSecretary();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && (
          request.resource.data.role == 'patient'
          || (request.resource.data.role == 'secretary' && hasStaffInvite())
        );

      allow update: if
        // Staff can edit other fields, but not someone else's picture.
        // Exception: they may fill one in when it is empty (the child
        // hand-over copies the child's picture to the adult account).
        (
          isSecretary()
          && (
            isOwner(userId)
            || !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['profileCharacter'])
            || resource.data.get('profileCharacter', '') == ''
          )
        )
        // Users can edit their own profile, including their picture.
        || (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'role', 'idNumber', 'email', 'createdAt'])
        );

      allow delete: if false;
    }

    // ---------- staffInvites ----------

    match /staffInvites/{inviteEmail} {
      allow get: if isSignedIn()
        && request.auth.token.email != null
        && inviteEmail == request.auth.token.email.lower();

      allow list: if isSecretary();
      allow write: if isSecretary();
    }

    // ---------- secretaryDirectory ----------

    match /secretaryDirectory/{uid} {
      allow read: if isSignedIn();

      allow create, update: if isOwner(uid)
        && isSecretary()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == uid;

      allow delete: if isSecretary();
    }

    // ---------- idNumberIndex ----------

    match /idNumberIndex/{idNum} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['patientUid', 'secretaryUid'])
        && (
          (
            request.resource.data.patientUid == request.auth.uid
            && request.resource.data.secretaryUid == null
          )
          || (
            request.resource.data.secretaryUid == request.auth.uid
            && request.resource.data.patientUid == null
          )
        );

      allow update: if isSignedIn()
        && resource.data.secretaryUid != null
        && resource.data.patientUid == null
        && request.resource.data.patientUid == request.auth.uid
        && request.resource.data.secretaryUid == resource.data.secretaryUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['patientUid']);

      allow delete: if false;
    }

    // ---------- children ----------

    match /children/{childId} {

      // A guardian can only read children linked to their account.
      allow get: if isSecretary()
        || (
          request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.uid in resource.data.guardianIds
          && request.time < resource.data.turns18At
        );

      // List queries must be provable from the query itself. The guardian's
      // query filters on guardianIds array-contains their own uid, so that is
      // what is enforced here. Children aged 18+ are dropped client-side and
      // are blocked on direct reads by the rule above.
      allow list: if isSecretary()
        || (
          request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.uid in resource.data.guardianIds
        );

      // New child profiles must be created by the signed-in guardian.
      // Verification must always begin as pending.
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'name',
          'dateOfBirth',
          'idType',
          'idNumber',
          'guardianIds',
          'primaryGuardianId',
          'guardians',
          'status',
          'verificationStatus',
          'turns12At',
          'turns18At',
          'createdBy',
          'createdAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.primaryGuardianId == request.auth.uid
        && request.resource.data.guardianIds == [request.auth.uid]
        && request.resource.data.status == 'managed'
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.dateOfBirth is string
        && request.resource.data.turns12At is timestamp
        && request.resource.data.turns18At is timestamp
        && request.resource.data.turns18At > request.time
        && request.resource.data.turns18At <= request.time + duration.value(6575, 'd');

      allow update: if
        // The practice can update and verify a child's profile, but cannot
        // change the picture.
        (
          isSecretary()
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['profileCharacter'])
        )
        // The child's guardian may change the picture, and nothing else.
        || (
          isActiveGuardianOf(childId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['profileCharacter'])
          && request.resource.data.profileCharacter is string
          && request.resource.data.profileCharacter.size() <= 3
        )
        // A guardian may mark the intake as submitted, but cannot alter
        // verification, identity, or other child-profile data.
        || (
          isActiveGuardianOf(childId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hasCompletedIntake', 'intakeCompletedAt'])
          && request.resource.data.hasCompletedIntake == true
          && request.resource.data.intakeCompletedAt is timestamp
        );

      allow delete: if false;
    }

    // ---------- appointments ----------

    match /appointments/{appointmentId} {

      allow read: if isSecretary()
        || isOwner(resource.data.patientId)
        || isActiveGuardianOf(resource.data.patientId)
        || isUnclaimedByCallerIdNumber();

      allow create: if isSecretary()
        || (
          isSignedIn()
          && (
            request.resource.data.patientId == request.auth.uid
            || isActiveGuardianOf(request.resource.data.patientId)
          )
        );

      allow update: if isSecretary()
        || (
          isSignedIn()
          && (
            resource.data.patientId == request.auth.uid
            || isActiveGuardianOf(request.resource.data.patientId)
          )
          && request.resource.data.patientId == resource.data.patientId
          && (
            (
              // Patient or guardian may report running late.
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'patientRunningLate',
                  'patientRunningLateMinutes',
                  'patientRunningLateAt',
                  'updatedAt'
                ])
              && request.resource.data.patientRunningLate == true
            )
            || (
              // Patient or guardian may cancel an appointment.
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status',
                  'cancelledAt',
                  'cancelledBy',
                  'updatedAt'
                ])
              && request.resource.data.status == 'cancelled'
              && request.resource.data.cancelledBy == request.auth.uid
              && request.time + duration.value(3, 'h')
                < resource.data.appointmentAt
              && resource.data.status != 'cancelled'
            )
          )
        );

      allow delete: if isSecretary();
    }

    // ---------- appointmentSlots ----------

    match /appointmentSlots/{slotId} {

      allow read: if isSignedIn();

      allow create: if isSecretary()
        || (
          isSignedIn()
          && request.resource.data.keys().hasOnly([
            'date',
            'time',
            'status',
            'appointmentId',
            'patientId',
            'doctorId'
          ])
          && (
            request.resource.data.patientId == request.auth.uid
            || isActiveGuardianOf(request.resource.data.patientId)
          )
        );

      allow update: if isSecretary()
        || (
          ownsAppointmentSlot(resource.data.appointmentId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'doctorId'])
        );

      allow delete: if isSecretary()
        || ownsAppointmentSlot(resource.data.appointmentId);
    }

    // ---------- notifications ----------

    // PUSH: each user can read and write only their own push tokens.
    match /pushTokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /notifications/{notificationId} {

      allow read: if isSecretary()
        || isOwner(resource.data.recipientId)
        || isActiveGuardianOf(resource.data.recipientId);

      allow create: if isSecretary()
        || (
          isSignedIn()
          && request.resource.data.recipientId == request.auth.uid
        )
        || isGuardianAppointmentNotification()
        || (
          isSignedIn()
          && isSecretaryRecipient(request.resource.data.recipientId)
        );

      allow update: if isSecretary()
        || isOwner(resource.data.recipientId)
        || isActiveGuardianOf(resource.data.recipientId);

      allow delete: if isSecretary();
    }

    // ---------- blockedSlots ----------

    match /blockedSlots/{slotId} {
      allow read: if isSignedIn();
      allow write: if isSecretary();
    }

    // ---------- records ----------

    match /records/{recordId} {

      allow read: if isSecretary()
        || isOwner(resource.data.patientId)
        || isVerifiedGuardianOf(resource.data.patientId)
        || isUnclaimedByCallerIdNumber();

      // Only secretaries can create, edit or delete medical records.
      allow write: if isSecretary();
    }

    // ---------- patientProfiles ----------

    match /patientProfiles/{profileId} {

      allow read: if isSecretary()
        || isOwner(resource.data.patientId)
        || isVerifiedGuardianOf(resource.data.patientId)
        || isUnclaimedByCallerIdNumber();

      allow create: if isSecretary()
        || (
          isSignedIn()
          && request.resource.data.patientId == request.auth.uid
          && request.resource.data.diff({}).affectedKeys()
            .hasOnly(patientEditableProfileFields())
        );

      allow update: if isSecretary()
        || (
          isOwner(resource.data.patientId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(patientEditableProfileFields())
        );

      allow delete: if isSecretary();
    }

    // ---------- practice ----------

    match /practice/{docId} {
      allow read: if isSignedIn();
      allow write: if isSecretary();
    }

    // ---------- doctors ----------

    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow write: if isSecretary();
    }

    // ---------- doctorRatings ----------

    match /doctorRatings/{appointmentId} {

      allow read: if isSecretary()
        || (isSignedIn() && (resource == null || resource.data.hidden == false));

      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.appointmentId == appointmentId
        && request.resource.data.hidden == false
        && exists(/databases/$(database)/documents/appointments/$(appointmentId))
        && get(
          /databases/$(database)/documents/appointments/$(appointmentId)
        ).data.patientId == request.auth.uid;

      allow update: if isSecretary()
        || (
          isSignedIn()
          && resource.data.patientId == request.auth.uid
          && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.doctorId == resource.data.doctorId
          && request.resource.data.appointmentId == resource.data.appointmentId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'comment', 'updatedAt'])
        );

      allow delete: if isSecretary();
    }

    // ---------- intakeForms ----------

    match /intakeForms/{intakeId} {

      allow read: if isSecretary()
        || isOwner(resource.data.patientId)
        || isVerifiedGuardianOf(resource.data.patientId)
        // Parents may access the intake form they submit for a child; this
        // does not grant access to the child's other clinical records.
        || isActiveGuardianOf(resource.data.patientId)
        || isUnclaimedByCallerIdNumber();

      allow create: if isSecretary()
        || (
          isSignedIn()
          && request.resource.data.patientId == request.auth.uid
          && request.resource.data.submittedBy == 'patient'
        )
        || (
          isActiveGuardianOf(request.resource.data.patientId)
          && request.resource.data.submittedBy == 'guardian'
        );

      allow update: if isSecretary()
        || (
          isSignedIn()
          && resource.data.patientId == null
          && request.resource.data.patientId == request.auth.uid
          && resource.data.patientIdNumber == callerDoc().data.idNumber
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['patientId'])
        );

      allow delete: if isSecretary();
    }

    // ---------- changeRequests ----------

    match /changeRequests/{requestId} {

      allow read: if isSecretary()
        || isOwner(resource.data.patientId);

      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.resolvedBy == null
        && request.resource.data.resolvedAt == null;

      allow update: if isSecretary();
      allow delete: if isSecretary();
    }

    // ---------- conversations ----------

    match /conversations/{patientId} {

      allow read: if isSecretary()
        || isOwner(patientId)
        || isActiveGuardianOf(patientId);

      allow create: if isSecretary()
        || (
          (isOwner(patientId) || isActiveGuardianOf(patientId))
          && request.resource.data.patientId == patientId
          && request.resource.data.lastSenderRole == 'patient'
          && request.resource.data.unreadForStaff == 1
          && request.resource.data.diff({}).affectedKeys()
            .hasOnly([
              'patientId',
              'patientName',
              'lastMessage',
              'lastMessageAt',
              'lastSenderRole',
              'unreadForStaff'
            ])
        );

      allow update: if isSecretary()
        || (
          (isOwner(patientId) || isActiveGuardianOf(patientId))
          && request.resource.data.patientId == patientId
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'patientId',
                  'patientName',
                  'lastMessage',
                  'lastMessageAt',
                  'lastSenderRole',
                  'unreadForStaff'
                ])
              && request.resource.data.lastSenderRole == 'patient'
              && request.resource.data.unreadForStaff
                == resource.data.get('unreadForStaff', 0) + 1
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['unreadForPatient'])
              && request.resource.data.unreadForPatient == 0
            )
          )
        );

      allow delete: if isSecretary();

      // ---------- messages ----------

      match /messages/{messageId} {

        allow read: if isSecretary()
          || isOwner(patientId)
          || isActiveGuardianOf(patientId);

        allow create: if isSecretary()
          || (
            (isOwner(patientId) || isActiveGuardianOf(patientId))
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'patient'
            && request.resource.data.kind == 'message'
          );

        allow update: if false;
        allow delete: if isSecretary();
      }
    }

    // ---------- analytics ----------

    match /analyticsEvents/{eventId} {
      allow read: if isSecretary();
      allow create: if isSecretary();
      allow update: if isSecretary();
      allow delete: if isSecretary();
    }

    match /analyticsSummary/{summaryId} {
      allow read: if isSecretary();
      allow create: if isSecretary();
      allow update: if isSecretary();
      allow delete: if isSecretary();
    }
  }
}
